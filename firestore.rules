rules_version = '2';

// Server-side enforcement for group orders. Mirrors the client logic in
// src/features/order/services/api.ts (createGroupOrder / upsertOrderItem).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /orders/{orderId} {
      function itemPath(uid) {
        return /databases/$(database)/documents/orders/$(orderId)/items/$(uid);
      }

      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'orderName', 'orderDescription', 'maxParticipants', 'lastOrderAt',
          'ownerUid', 'participantsCount', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.orderName is string
        && request.resource.data.orderName.size() >= 3
        && request.resource.data.orderName.size() <= 50
        && request.resource.data.orderDescription is string
        && request.resource.data.orderDescription.size() <= 200
        && request.resource.data.maxParticipants is int
        && request.resource.data.maxParticipants >= 1
        && request.resource.data.maxParticipants <= 100
        && request.resource.data.lastOrderAt is timestamp
        && request.resource.data.lastOrderAt > request.time
        && request.resource.data.participantsCount == 0;

      // Joining: claim exactly one slot, only while open and not full,
      // and only together with creating the caller's own item.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['participantsCount', 'updatedAt'])
        && request.resource.data.participantsCount == resource.data.participantsCount + 1
        && request.resource.data.participantsCount <= resource.data.maxParticipants
        && resource.data.lastOrderAt > request.time
        && !exists(itemPath(request.auth.uid))
        && existsAfter(itemPath(request.auth.uid));

      allow delete: if false;

      match /items/{uid} {
        function order() {
          return get(/databases/$(database)/documents/orders/$(orderId)).data;
        }

        function validItem() {
          let data = request.resource.data;
          return data.participantName is string
            && data.participantName.size() >= 1
            && data.participantName.size() <= 50
            && data.items is list
            && data.items.size() >= 1
            && data.items.size() <= 10
            && (data.note == null || (data.note is string && data.note.size() <= 200));
        }

        allow read: if signedIn();

        // Creating an item must claim a slot on the order in the same transaction
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys()
               .hasOnly(['participantName', 'note', 'items', 'createdByUid', 'createdAt'])
          && request.resource.data.createdByUid == uid
          && validItem()
          && order().lastOrderAt > request.time
          && getAfter(/databases/$(database)/documents/orders/$(orderId)).data.participantsCount
               == order().participantsCount + 1;

        allow update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['participantName', 'note', 'items', 'updatedAt'])
          && validItem()
          && order().lastOrderAt > request.time;

        allow delete: if false;
      }
    }
  }
}
