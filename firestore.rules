rules_version = '2';

// Server-side enforcement for group orders. Mirrors the client logic in
// src/features/order/services/api.ts.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /orders/{orderId} {
      function orderPath() {
        return /databases/$(database)/documents/orders/$(orderId);
      }

      function itemPath(uid) {
        return /databases/$(database)/documents/orders/$(orderId)/items/$(uid);
      }

      // Orders created before `status` existed are open
      function isOpen(order) {
        return order.get('status', 'open') == 'open' && order.lastOrderAt > request.time;
      }

      function isOwner(order) {
        return order.ownerUid == request.auth.uid;
      }

      // Fields the owner sets on create / edit
      function validSettings(data) {
        return data.orderName is string
          && data.orderName.size() >= 3
          && data.orderName.size() <= 50
          && data.orderDescription is string
          && data.orderDescription.size() <= 200
          && data.maxParticipants is int
          && data.maxParticipants >= 1
          && data.maxParticipants <= 100
          && data.lastOrderAt is timestamp
          && data.get('extraFee', 0) is int
          && data.get('extraFee', 0) >= 0
          && data.get('extraFee', 0) <= 10000000
          && data.get('paymentInfo', '') is string
          && data.get('paymentInfo', '').size() <= 300
          && data.get('menu', []) is list
          && data.get('menu', []).size() <= 30;
      }

      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'orderName', 'orderDescription', 'maxParticipants', 'lastOrderAt',
          'extraFee', 'paymentInfo', 'menu', 'status',
          'ownerUid', 'participantsCount', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && validSettings(request.resource.data)
        && request.resource.data.lastOrderAt > request.time
        && request.resource.data.status == 'open'
        && request.resource.data.participantsCount == 0;

      // 1) Owner edits settings / opens / closes
      // 2) Participant joins: claim exactly one slot together with creating own item
      // 3) Participant leaves (or owner removes someone): release exactly one slot
      allow update: if signedIn() && (
        (
          isOwner(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'orderName', 'orderDescription', 'maxParticipants', 'lastOrderAt',
               'extraFee', 'paymentInfo', 'menu', 'status', 'updatedAt'
             ])
          && validSettings(request.resource.data)
          && request.resource.data.get('status', 'open') in ['open', 'closed']
          && request.resource.data.maxParticipants >= resource.data.participantsCount
          && (
            !('lastOrderAt' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.lastOrderAt > request.time
          )
        ) || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['participantsCount', 'updatedAt'])
          && request.resource.data.participantsCount == resource.data.participantsCount + 1
          && request.resource.data.participantsCount <= resource.data.maxParticipants
          && isOpen(resource.data)
          && !exists(itemPath(request.auth.uid))
          && existsAfter(itemPath(request.auth.uid))
        ) || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['participantsCount', 'updatedAt'])
          && request.resource.data.participantsCount == resource.data.participantsCount - 1
          && (
            isOwner(resource.data)
            || (exists(itemPath(request.auth.uid)) && !existsAfter(itemPath(request.auth.uid)))
          )
        )
      );

      allow delete: if false;

      match /items/{uid} {
        function order() {
          return get(orderPath()).data;
        }

        function validItem() {
          let data = request.resource.data;
          return data.participantName is string
            && data.participantName.size() >= 1
            && data.participantName.size() <= 50
            && data.items is list
            && data.items.size() >= 1
            && data.items.size() <= 10
            && (data.note == null || (data.note is string && data.note.size() <= 200));
        }

        allow read: if signedIn();

        // Creating an item must claim a slot on the order in the same transaction
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys()
               .hasOnly(['participantName', 'note', 'items', 'createdByUid', 'createdAt'])
          && request.resource.data.createdByUid == uid
          && validItem()
          && isOpen(order())
          && getAfter(orderPath()).data.participantsCount == order().participantsCount + 1;

        // Participant edits own items while open; owner only toggles payment
        allow update: if signedIn() && (
          (
            request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['participantName', 'note', 'items', 'updatedAt'])
            && validItem()
            && isOpen(order())
          ) || (
            isOwner(order())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPaid'])
            && request.resource.data.isPaid is bool
          )
        );

        // Deleting an item must release a slot in the same transaction
        allow delete: if signedIn()
          && (isOwner(order()) || (request.auth.uid == uid && isOpen(order())))
          && getAfter(orderPath()).data.participantsCount == order().participantsCount - 1;
      }
    }
  }
}
